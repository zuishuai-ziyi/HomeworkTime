# Node 依赖
node_modules/
server/node_modules/
server/web/node_modules/
client/node_modules/

# 构建产物
server/web/dist/
client/dist/
# PyInstaller 打包中间产物（build.py 每次构建重新生成，不入库）
client/build/
client/HomeworkTime.spec

# 敏感配置：服务端 .env 包含 DB 密码与 JWT 密钥，禁止入库
server/.env

# 客户端本机专属配置 + 打包预设（含 server_base_url / client_token）
# 打包预设虽仅在打包前填写，但任何状态下都禁止入库，避免真实凭据泄露
client/local_config.json
client/local_config.preset.json

# 上传与缓存
server/uploads/audio/*
!server/uploads/audio/.gitkeep
client/cache/
client/logs/

# Python
__pycache__/
*.pyc

# 环境变量（含密钥，绝不入库）
.env
*.env
!.env.example

# IDE / 系统文件
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
